{
  "$id": "https://github.com/trbrewer/espresso-whole-pull/schemas/sci_data_fusion_001_audit_record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audit_disposition": {
      "const": "SCI_DATA_FUSION_001_SINGLE_INDEPENDENT_PREEXECUTION_AUDIT_PASS"
    },
    "audit_type": {
      "const": "SINGLE_INDEPENDENT_PREEXECUTION_AUDIT"
    },
    "material_findings": {
      "maxItems": 0,
      "type": "array"
    },
    "review_date": {
      "format": "date",
      "type": "string"
    },
    "review_record_reference": {
      "minLength": 1,
      "type": "string"
    },
    "reviewed_authorities": {
      "minProperties": 1,
      "type": "object"
    },
    "reviewed_freeze_content_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "reviewed_head": {
      "not": {
        "enum": [
          "54b2164eaf81907a8573d54e89fd8eecbf99293e",
          "1f9b8758c2b2b756eeb29daab28b4dce0cf3525b"
        ]
      },
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "reviewed_tree": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "reviewer_identity": {
      "minLength": 1,
      "type": "string"
    },
    "reviewer_independence_statement": {
      "minLength": 1,
      "type": "string"
    },
    "task_id": {
      "const": "SCI-DATA-FUSION-001"
    }
  },
  "required": [
    "task_id",
    "audit_type",
    "audit_disposition",
    "reviewed_head",
    "reviewed_tree",
    "reviewed_freeze_content_manifest_sha256",
    "reviewer_identity",
    "reviewer_independence_statement",
    "reviewed_authorities",
    "material_findings",
    "review_record_reference",
    "review_date"
  ],
  "type": "object"
}
