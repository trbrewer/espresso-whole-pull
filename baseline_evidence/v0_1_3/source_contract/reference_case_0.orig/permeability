FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      permeability;
}

dimensions      [0 2 0 0 0 0 0];

internalField   uniform 1.77e-15;

boundaryField
{
    inlet
    {
        type zeroGradient;
    }
    outlet
    {
        type zeroGradient;
    }
    outerWall
    {
        type zeroGradient;
    }
    axis
    {
        type empty;
    }
    wedgeMinus
    {
        type wedge;
    }
    wedgePlus
    {
        type wedge;
    }
}
