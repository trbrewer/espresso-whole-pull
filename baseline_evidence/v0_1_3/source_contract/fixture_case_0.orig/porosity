FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      porosity;
}

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.4;

boundaryField
{
    inlet
    {
        type zeroGradient;
    }
    outlet
    {
        type zeroGradient;
    }
    outerWall
    {
        type zeroGradient;
    }
    axis
    {
        type empty;
    }
    wedgeMinus
    {
        type wedge;
    }
    wedgePlus
    {
        type wedge;
    }
}
