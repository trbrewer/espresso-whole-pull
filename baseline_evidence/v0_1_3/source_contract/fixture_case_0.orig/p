FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type fixedValue;
        value uniform 0;
    }
    outlet
    {
        type fixedValue;
        value uniform 0;
    }
    outerWall
    {
        type zeroGradient;
    }
    axis
    {
        type empty;
    }
    wedgeMinus
    {
        type wedge;
    }
    wedgePlus
    {
        type wedge;
    }
}
