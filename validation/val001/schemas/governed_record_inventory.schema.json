{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "espresso.val001.governed_record_inventory.v3",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "scope",
    "record_count",
    "records",
    "closure"
  ],
  "properties": {
    "schema_version": {
      "const": "espresso.val001.governed_record_inventory.v3"
    },
    "record_id": {
      "const": "VAL001-GOVERNED-RECORD-INVENTORY-3"
    },
    "scope": {
      "const": "EVERY_JSON_AND_JSONL_UNDER_VALIDATION_VAL001_ZERO_EXCLUSIONS"
    },
    "record_count": {
      "type": "integer",
      "minimum": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "git_blob",
          "producing_commit",
          "record_id",
          "artifact_record_id",
          "record_class",
          "schema_id",
          "schema_version",
          "schema_path",
          "semantic_validator",
          "semantic_profile",
          "schema_origin",
          "binding_class",
          "binder",
          "treatment",
          "current",
          "executable",
          "audit_only",
          "mutability",
          "governing",
          "superseded",
          "claim_ceiling",
          "puckworks_lock_applicable",
          "source_access_role",
          "static_validation",
          "structure_signature_sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.).+$"
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "git_blob": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{40}$"
          },
          "producing_commit": {
            "type": "string",
              "pattern": "^([0-9a-f]{40}|PENDING_[A-Z_]+|BOUND_BY_BINDER|BOUND_BY_FINAL_GIT_TREE)$"
          },
          "record_id": {
            "type": "string",
            "pattern": "^INV-[0-9A-F]{20}$"
          },
          "artifact_record_id": {
            "type": "string"
          },
          "record_class": {
            "type": "string"
          },
          "schema_id": {
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          },
          "schema_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.).+\\.json$"
          },
          "semantic_validator": {
            "const": "VALIDATE_DEEP_AND_CROSS_RECORD"
          },
          "semantic_profile": {
            "const": "VAL001_EXPLICIT_PROFILE_V1"
          },
          "schema_origin": {
            "const": "EXPLICIT_CLASS_OR_VERSION_SEMANTICS"
          },
          "binding_class": {
            "enum": [
              "ORDINARY_HASH_BOUND_RECORD",
              "BOUND_BY_ADMINISTRATIVE_FREEZE",
              "BOUND_BY_CANONICAL_LOCK",
              "BOUND_BY_FINAL_GIT_TREE"
            ]
          },
          "binder": {
            "type": "string"
          },
          "treatment": {
            "enum": [
              "CURRENT_DEEP_SCHEMA",
              "IMMUTABLE_HISTORICAL_DEEP_SCHEMA"
            ]
          },
          "current": {
            "type": "boolean"
          },
          "executable": {
            "const": false
          },
          "audit_only": {
            "type": "boolean"
          },
          "mutability": {
            "const": "IMMUTABLE_AFTER_ADMINISTRATIVE_FREEZE"
          },
          "governing": {
            "type": "boolean"
          },
          "superseded": {
            "type": "boolean"
          },
          "claim_ceiling": {
            "const": "NO_PHYSICAL_VALIDATION_OR_NEW_PHYSICS"
          },
          "puckworks_lock_applicable": {
            "const": true
          },
          "source_access_role": {
            "enum": [
              "NO_SOURCE_ACCESS",
              "SOURCE_ACCESS_AUDIT"
            ]
          },
          "static_validation": {
            "const": "REQUIRED"
          },
          "structure_signature_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "closure": {
      "type": "object",
      "required": [
        "enumeration_exclusions",
        "administrative_freeze",
        "canonical_lock",
        "terminal_external_root",
        "sidecar_primary_validation_count"
      ],
      "properties": {
        "enumeration_exclusions": {
          "const": 0
        },
        "administrative_freeze": {
          "type": "string"
        },
        "canonical_lock": {
          "type": "string"
        },
        "terminal_external_root": {
          "const": "FINAL_GIT_HEAD_TREE"
        },
        "sidecar_primary_validation_count": {
          "const": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
