    "comparisons": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "required": ["comparison_id", "classification", "metrics", "residual_table", "uncertainty_disposition"], "properties": {"comparison_id": {"type": "string", "minLength": 1}, "classification": {"enum": ["POST_FIT_SOURCE_RECONSTRUCTION", "POST_FIT_SOURCE_RECONSTRUCTION_WITH_9BAR_MATCHING_CIRCULARITY"]}, "metrics": {"type": "object", "required": ["n", "rmse", "mae", "mean_bias", "maximum_absolute_error", "r_squared_descriptive", "units", "sample_count", "pressure_conditions_bar", "support_bar", "weighting", "uncertainty_status", "gate_bearing"], "properties": {"n": {"type": "integer", "minimum": 1}, "rmse": {"type": "number", "minimum": 0}, "mae": {"type": "number", "minimum": 0}, "mean_bias": {"type": "number"}, "maximum_absolute_error": {"type": "number", "minimum": 0}, "r_squared_descriptive": {"anyOf": [{"type": "number"}, {"type": "null"}]}, "units": {"const": "g/s except dimensionless r_squared_descriptive"}, "sample_count": {"type": "integer", "minimum": 1}, "pressure_conditions_bar": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "number"}}, "support_bar": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}, "weighting": {"const": "EQUAL_SELECTED_CONDITION"}, "uncertainty_status": {"const": "SOURCE_UNCERTAINTY_NOT_REPORTED"}, "gate_bearing": {"const": false}}, "additionalProperties": false}, "residual_table": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "object", "required": ["nominal_pressure_bar", "observation_g_s", "prediction_g_s", "residual_g_s"], "properties": {"nominal_pressure_bar": {"type": "number"}, "observation_g_s": {"type": "number"}, "prediction_g_s": {"type": "number"}, "residual_g_s": {"type": "number"}}, "additionalProperties": false}}, "uncertainty_disposition": {"const": "DESCRIPTIVE_COMPARISON_NO_UNCERTAINTY_GATE"}}, "additionalProperties": false}},
    "interpretation": {"type": "object", "required": ["rules_fired", "decision", "variant_discrimination", "physical_equivalence", "model_correctness", "mechanism_identification", "blind_status", "independence_status"], "properties": {"rules_fired": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "decision": {"const": "ADDITIONAL_DATA_REQUIRED_BEFORE_NEW_PHYSICS"}, "variant_discrimination": {"const": "NOT_ESTABLISHED"}, "physical_equivalence": {"const": "NOT_ESTABLISHED"}, "model_correctness": {"const": "NOT_ESTABLISHED"}, "mechanism_identification": {"const": "NOT_ESTABLISHED"}, "blind_status": {"const": "NOT_BLIND"}, "independence_status": {"const": "NOT_INDEPENDENT"}}, "additionalProperties": false},
    "claim_boundaries": {"type": "object", "required": ["physical_validation", "general_physical_validation", "general_whole_solver_physical_validation", "experimental_commissioning", "protected_or_holdout_scoring", "holdout_execution", "new_governing_physics"], "properties": {"physical_validation": {"const": "NOT_ESTABLISHED"}, "general_physical_validation": {"const": "NOT_ESTABLISHED"}, "general_whole_solver_physical_validation": {"const": "NOT_ESTABLISHED"}, "experimental_commissioning": {"const": "NOT_AUTHORIZED"}, "protected_or_holdout_scoring": {"const": "NOT_AUTHORIZED"}, "holdout_execution": {"const": "NOT_AUTHORIZED"}, "new_governing_physics": {"const": "NOT_AUTHORIZED_BY_VAL001"}}, "additionalProperties": false}
  }, "additionalProperties": false
}
