{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/trbrewer/espresso-whole-pull/validation/val001/schemas/source_adapter.schema.json",
  "title": "VAL-001 source adapter",
  "type": "object",
  "required": ["schema_version", "adapter_id", "source", "evidence", "rights", "quantities", "solver_mapping", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "espresso.val001.source_adapter.v1"},
    "adapter_id": {"type": "string", "minLength": 1},
    "source": {"type": "object"},
    "evidence": {"type": "object"},
    "rights": {"type": "object"},
    "quantities": {"type": "array", "minItems": 1},
    "solver_mapping": {"type": "object"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
