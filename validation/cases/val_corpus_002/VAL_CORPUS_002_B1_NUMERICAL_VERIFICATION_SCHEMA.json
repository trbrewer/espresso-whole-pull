{
  "$id": "espresso.val_corpus_002.b1_numerical_verification.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorization_id": {"const": "VAL-CORPUS-002-B1-CALIBRATION-2026-08-03"},
    "boundedness": {"additionalProperties": false, "required": ["finite", "nonnegative", "tds_0_to_1"], "type": "object"},
    "calibration_case_id": {"const": "SCHM_EXP7_P2_FIXED_AFTER_EXP7_CALIBRATION_H1"},
    "calibration_configuration_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "completion_disposition": {"const": "PASS"},
    "delta_t_s": {"const": 0.02},
    "end_time_s": {"const": 90.0},
    "executable_sha256": {"const": "e682bb63d4b54a19133a81e1dc857217132b91918ecceb33ffbc88c35b6b0fd6"},
    "fatal_event_count": {"const": 0},
    "final_solver_timestamp_s": {"type": "number"},
    "first_solver_timestamp_s": {"type": "number"},
    "liquid_balance_gate": {"const": 1e-8},
    "maximum_liquid_balance_relative_residual": {"minimum": 0, "type": "number"},
    "maximum_solute_balance_relative_residual": {"minimum": 0, "type": "number"},
    "mpi_ranks": {"const": 16},
    "openfoam_distribution": {"const": "OpenFOAM Foundation"},
    "openfoam_version": {"const": "12"},
    "overall_status": {"const": "PASS"},
    "schema_version": {"const": "espresso.val_corpus_002.b1_numerical_verification.v1"},
    "selected_evaluation_sequence": {"minimum": 0, "type": "integer"},
    "solute_balance_gate": {"const": 1e-8},
    "solver_commit": {"const": "0a5c146078da5d5f88b344b20e7b81042bf27ddb"},
    "target_mass_brackets": {"additionalProperties": false, "required": ["20_g", "40_g", "60_g"], "type": "object"},
    "task": {"const": "VAL-CORPUS-002"},
    "trace_bytes": {"minimum": 1, "type": "integer"},
    "trace_header_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "trace_path": {"minLength": 1, "type": "string"},
    "trace_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "required": [
    "schema_version", "task", "authorization_id", "calibration_case_id", "solver_commit",
    "executable_sha256", "calibration_configuration_sha256", "openfoam_distribution",
    "openfoam_version", "mpi_ranks", "delta_t_s", "end_time_s", "first_solver_timestamp_s",
    "final_solver_timestamp_s", "completion_disposition", "fatal_event_count",
    "target_mass_brackets", "boundedness", "maximum_liquid_balance_relative_residual",
    "maximum_solute_balance_relative_residual", "liquid_balance_gate", "solute_balance_gate",
    "trace_path", "trace_sha256", "trace_bytes", "trace_header_sha256",
    "selected_evaluation_sequence", "overall_status"
  ],
  "type": "object"
}
